# ─── BUILDEX PORTAL — env ცვლადების ნიმუში ───────────────────────────────────
# დააკოპირე .env-ად და შეავსე რეალური მნიშვნელობებით.
# server.js-ის fail-fast guard აპლიკაციას არ ჩართავს, თუ სავალდებულოები აკლია.

# ── სავალდებულო ──
# კრიპტოგრაფიულად ძლიერი, მინ. 32 სიმბოლო (მაგ: openssl rand -hex 32)
JWT_SECRET=
# MongoDB კავშირის სტრიქონი
MONGODB_URI=

# ── სავალდებულო production-ში (ფაილების მუდმივი შენახვა) ──
# ან CLOUDINARY_URL, ან სამივე ცალკე ცვლადი:
CLOUDINARY_URL=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ── არასავალდებულო ──
NODE_ENV=production
PORT=8080
JWT_TTL=2h
# CORS whitelist (მძიმით გამოყოფილი origin-ები; ცარიელი = ნებადართული dev-ში)
CORS_ORIGINS=https://buildexportal-production.up.railway.app
# JSON body-ის ლიმიტი (base64 ფოტოებისთვის)
JSON_BODY_LIMIT=12mb
# AI ფუნქცია (Anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── seed-admin.js სკრიპტისთვის (npm run seed-admin) ──
ADMIN_USERNAME=admin
# მინ. 12 სიმბოლო
ADMIN_PASSWORD=
